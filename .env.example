# PostgreSQL Relational + pgvector Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jurispredict_db"
PGHOST="localhost"
PGPORT="5432"
PGDATABASE="jurispredict_db"
PGUSER="postgres"
PGPASSWORD="your_secure_password_here"

# Application Security & JWT
